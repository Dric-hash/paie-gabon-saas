# ─────────────────────────────────────────────────────────────────
# PaieGabon SaaS — Variables d'environnement
# Copiez ce fichier en .env et renseignez les valeurs.
# Ne committez JAMAIS le fichier .env dans Git.
# ─────────────────────────────────────────────────────────────────

# ── Obligatoire en production ──────────────────────────────────────
# Générez avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-generez-une-vraie-cle

# URL PostgreSQL (fournie par votre hébergeur / VPS Hostinger)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Compte super-admin initial (créé au premier démarrage) ─────────
SUPER_ADMIN_EMAIL=admin@votre-entreprise.ga
SUPER_ADMIN_PASSWORD=MotDePasseForte2026!

# Compte démo (optionnel)
DEMO_EMAIL=demo@votre-entreprise.ga
DEMO_PASSWORD=MotDePasseDemoForte!

# ── Cache Redis + limiteur de débit (fortement recommandé en prod) ──
# Sans Redis : cache désactivé (KPIs recalculés à chaque requête) et
# limiteur de débit en mémoire (non partagé entre workers gunicorn).
# VPS (Redis installé localement) :
# REDIS_URL=redis://localhost:6379/0
# VPS avec mot de passe Redis (requirepass) :
# REDIS_URL=redis://:motdepasse@localhost:6379/0

# ── Monitoring des erreurs (Sentry) ────────────────────────────────
# Créez un projet Python/Flask sur https://sentry.io et copiez le DSN.
# Sans SENTRY_DSN, le monitoring est simplement désactivé.
# SENTRY_DSN=https://xxxxxxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_RATE=0.0   # 0.1 pour échantillonner 10% des transactions (perf)
# APP_VERSION=1.0.0        # optionnel : associe les erreurs à une version

# ── Email (Gmail) ──────────────────────────────────────────────────
# Créez un "Mot de passe d'application" dans votre compte Google
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application

# ── Session ────────────────────────────────────────────────────────
# Durée d'inactivité avant déconnexion automatique (minutes)
SESSION_TIMEOUT_MINUTES=60

# ── Protection brute force login ───────────────────────────────────
LOGIN_MAX_ECHECS=5
LOGIN_BLOCAGE_MIN=15

# ── Logs ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Décommenter pour voir les requêtes SQL (développement uniquement)
# SQLALCHEMY_ECHO=1

# URL publique de votre app (sans slash final)
# APP_BASE_URL=https://paiegabon.com

# ── Ameriack CRM (API commerciale en lecture seule) ─────────────────────────
# Clé partagée avec le CRM (même valeur que PAIEGABON_CRM_KEY dans le .env du CRM).
# Laisser vide = API désactivée. Générer : python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# CRM_API_KEY=
# Par défaut l'API n'accepte que les appels du serveur lui-même (127.0.0.1, sans nginx).
# CRM_API_LOCAL_SEULEMENT=1
